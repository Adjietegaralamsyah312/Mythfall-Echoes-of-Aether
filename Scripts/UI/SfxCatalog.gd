static func get_entry(sfx_id: String) -> Dictionary:
	for e: Dictionary in ENTRIES:
		if str(e.get("id", "")) == sfx_id:
			return e
	return {}


static func path_for(sfx_id: String) -> String:
	var e: Dictionary = get_entry(sfx_id)
	if e.is_empty():
		return ""
	return SFX_BASE + str(e.get("file", ""))


static func ids_for_use(use: String) -> Array[String]:
	var out: Array[String] = []
	for e: Dictionary in ENTRIES:
		if (e.get("use", []) as Array).has(use):
			out.append(str(e.get("id", "")))
	return out
